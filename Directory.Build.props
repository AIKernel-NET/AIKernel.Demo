<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <StablePackageVersion>0.1.3</StablePackageVersion>
    <LocalPackageVersionPrefix>0.1.3</LocalPackageVersionPrefix>
    <LocalPackageBuildNumber Condition="'$(LocalPackageBuildNumber)' == ''">0</LocalPackageBuildNumber>
    <UseLocalPackageVersion Condition="'$(UseLocalPackageVersion)' == ''">false</UseLocalPackageVersion>
    <Version Condition="'$(UseLocalPackageVersion)' == 'true'">$(LocalPackageVersionPrefix)-dev$(LocalPackageBuildNumber)</Version>
    <Version Condition="'$(UseLocalPackageVersion)' != 'true'">$(StablePackageVersion)</Version>
    <AssemblyVersion>$(StablePackageVersion).0</AssemblyVersion>
    <FileVersion>$(StablePackageVersion).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>

    <Authors>Takuya Sogawa</Authors>
    <Company>AIKernel-NET</Company>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/AIKernel-NET/AIKernel.Demo</RepositoryUrl>
    <Copyright>Copyright © 2026 Takuya Sogawa of AIKernel-NET</Copyright>
    <PackageTags>aikernel;demo;knowledge-os;rom;dsl;replay;capability;webapi;wasm</PackageTags>

    <AIKernelPackageVersion Condition="'$(UseLocalPackageVersion)' == 'true'">[$(LocalPackageVersionPrefix)-dev$(LocalPackageBuildNumber)]</AIKernelPackageVersion>
    <AIKernelPackageVersion Condition="'$(UseLocalPackageVersion)' != 'true'">[$(StablePackageVersion)]</AIKernelPackageVersion>
    <AIKernelCorePackageVersion Condition="'$(UseLocalPackageVersion)' == 'true'">$(LocalPackageVersionPrefix)-dev$(LocalPackageBuildNumber)</AIKernelCorePackageVersion>
    <AIKernelCorePackageVersion Condition="'$(UseLocalPackageVersion)' != 'true'">$(StablePackageVersion)</AIKernelCorePackageVersion>
    <AIKernelProviderPackageVersion Condition="'$(UseLocalPackageVersion)' == 'true'">$(LocalPackageVersionPrefix)-dev$(LocalPackageBuildNumber)</AIKernelProviderPackageVersion>
    <AIKernelProviderPackageVersion Condition="'$(UseLocalPackageVersion)' != 'true'">$(StablePackageVersion)</AIKernelProviderPackageVersion>
    <AIKernelWasmPackageVersion Condition="'$(UseLocalPackageVersion)' == 'true'">$(LocalPackageVersionPrefix)-dev$(LocalPackageBuildNumber)</AIKernelWasmPackageVersion>
    <AIKernelWasmPackageVersion Condition="'$(UseLocalPackageVersion)' != 'true'">$(StablePackageVersion)</AIKernelWasmPackageVersion>
    <AIKernelToolsPackageVersion Condition="'$(UseLocalPackageVersion)' == 'true'">$(LocalPackageVersionPrefix)-dev$(LocalPackageBuildNumber)</AIKernelToolsPackageVersion>
    <AIKernelToolsPackageVersion Condition="'$(UseLocalPackageVersion)' != 'true'">$(StablePackageVersion)</AIKernelToolsPackageVersion>
    <AIKernelControlPackageVersion Condition="'$(UseLocalPackageVersion)' == 'true'">$(LocalPackageVersionPrefix)-dev$(LocalPackageBuildNumber)</AIKernelControlPackageVersion>
    <AIKernelControlPackageVersion Condition="'$(UseLocalPackageVersion)' != 'true'">$(StablePackageVersion)</AIKernelControlPackageVersion>
    <AIKernelCudaPackageVersion Condition="'$(UseLocalPackageVersion)' == 'true'">$(LocalPackageVersionPrefix)-dev$(LocalPackageBuildNumber)</AIKernelCudaPackageVersion>
    <AIKernelCudaPackageVersion Condition="'$(UseLocalPackageVersion)' != 'true'">$(StablePackageVersion)</AIKernelCudaPackageVersion>
  </PropertyGroup>
</Project>
