<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <Version>0.1.2</Version>
    <AssemblyVersion>0.1.2.0</AssemblyVersion>
    <FileVersion>0.1.2.0</FileVersion>
    <InformationalVersion>0.1.2</InformationalVersion>

    <Authors>Takuya Sogawa</Authors>
    <Company>AIKernel-NET</Company>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/AIKernel-NET/AIKernel.Demo</RepositoryUrl>
    <Copyright>Copyright © 2026 Takuya Sogawa of AIKernel-NET</Copyright>
    <PackageTags>aikernel;demo;knowledge-os;rom;dsl;replay;capability;webapi;wasm</PackageTags>

    <AIKernelPackageVersion>[0.1.2]</AIKernelPackageVersion>
    <AIKernelCorePackageVersion>0.1.2</AIKernelCorePackageVersion>
    <AIKernelProviderPackageVersion>0.1.2</AIKernelProviderPackageVersion>
    <AIKernelWasmPackageVersion>0.1.2</AIKernelWasmPackageVersion>
    <AIKernelToolsPackageVersion>0.1.2</AIKernelToolsPackageVersion>
    <AIKernelControlPackageVersion>0.1.2</AIKernelControlPackageVersion>
    <AIKernelCudaPackageVersion>0.1.2</AIKernelCudaPackageVersion>
  </PropertyGroup>
</Project>
